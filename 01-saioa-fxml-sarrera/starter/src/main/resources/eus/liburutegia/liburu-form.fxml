<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="eus.liburutegia.controller.LiburuFormController"
          hgap="10" vgap="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Izenburua:"
           GridPane.rowIndex="0"
           GridPane.columnIndex="0"/>

    <TextField fx:id="txtIzenburua"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>

    <Label text="Egilea:"
           GridPane.rowIndex="1"
           GridPane.columnIndex="0"/>

    <TextField fx:id="txtEgilea"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>

    <Label fx:id="lblMezua"
           GridPane.rowIndex="4"
           GridPane.columnIndex="0"
           GridPane.columnSpan="2"/>

    <TextField fx:id="txtUrtea"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>

    <Button text="Gorde"
            onAction="#gorde"
            GridPane.rowIndex="3"
            GridPane.columnIndex="1"/>

</GridPane>
